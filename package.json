{
  "name": "personal-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && vite",
    "build": "node scripts/copy-assets.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "cd src-tauri && cargo test",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "mcp": "cd src-tauri && cargo run --quiet --bin workspace_mcp",
    "app:dmg": "npm run app:build && sh scripts/make-dmg.sh"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "5.9",
    "vite": "^8.3.5"
  }
}
